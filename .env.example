# Turso (libSQL) database — get from https://app.turso.tech
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_token_here

# Session secret — generate with: openssl rand -base64 32
SESSION_SECRET=replace_with_a_random_string_at_least_32_characters_long_aaaaa

# Login password (single shared password — pick anything)
APP_PASSWORD=change_me_to_something_secure
